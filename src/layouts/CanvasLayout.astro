---
import BaseLayout from './BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import ExperimentControls from '../components/ExperimentControls.astro';
import EquationWallpaper from '../components/EquationWallpaper.astro';

interface Props {
  name: string;
  description?: string;
  appId?: string;
  presets?: string[];
}

const { name, description, appId, presets = [] } = Astro.props;
const title = `${name} - incomplete.fun`;

---

<BaseLayout title={title} description={description}>
  <div class="canvas-app" id={appId}>
    <EquationWallpaper name={name} />
    <TopBar name={name} back>
      <slot name="toolbar" />
    </TopBar>
    <ExperimentControls presets={presets}>
      <slot name="controls" />
    </ExperimentControls>
    <aside class="math-notebook" aria-label="Math notebook">
      <strong>{name}</strong>
      <p>Definitions, examples, and nearby experiments live here as compact field notes while the canvas remains interactive.</p>
      <ul>
        <li><code>state</code>: current parameters and seed</li>
        <li><code>orbit</code>: repeated application of a rule</li>
        <li><a href="/">browse related experiments</a></li>
      </ul>
    </aside>
    <slot />
  </div>
</BaseLayout>

<script>
  import '../scripts/canvas-shell.ts';
</script>
