---
import BaseLayout from './BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import ExperimentControls from '../components/ExperimentControls.astro';
import { experiments } from '../data/experiments';

interface Props {
  name: string;
  description?: string;
  appId?: string;
  presets?: string[];
}

const { name, description, appId, presets = [] } = Astro.props;
const title = `${name} - incomplete.fun`;
const note = description ?? experiments.find(experiment => experiment.href === Astro.url.pathname.replace(/\/$/, ""))?.summary;

---

<BaseLayout title={title} description={description}>
  <div class="canvas-app" id={appId}>
    <TopBar name={name} back canvas />
    <section class="experiment-toolbar" aria-label="Experiment settings">
      <slot name="toolbar" />
    </section>
    <ExperimentControls presets={presets}>
      <slot name="controls" />
    </ExperimentControls>
    <slot />
    <details class="math-notebook">
      <summary>About this experiment</summary>
      <p>{note ?? `Explore ${name} by adjusting the settings above.`}</p>
      <a href="/#collection">Find another thread to follow <span aria-hidden="true">↗</span></a>
    </details>
  </div>
</BaseLayout>

<script>
  import '../scripts/canvas-shell.ts';
</script>
