---
import CanvasLayout from '../layouts/CanvasLayout.astro';
---

<CanvasLayout name="L-system garden" appId="lsystem-app" description="Rewrite symbols, then let a turtle walk the result. Tiny local grammar rules become curves, plants, and fractal silhouettes.">
  <Fragment slot="toolbar">
    <label class="control-label">
      preset
      <select id="lsystem-preset">
        <option value="koch">koch snowflake edge</option>
        <option value="dragon">dragon curve</option>
        <option value="sierpinski">sierpinski arrowhead</option>
        <option value="plant">fractal plant</option>
      </select>
    </label>
    <label class="control-label">
      axiom
      <input id="lsystem-axiom" type="text" value="F" />
    </label>
    <label class="control-label">
      iterations
      <input id="lsystem-iterations" type="number" min="0" max="8" value="4" />
    </label>
    <label class="control-label">
      angle
      <input id="lsystem-angle" type="number" min="1" max="180" value="60" />
    </label>
    <button class="toolbar-button" id="lsystem-grow" type="button">grow one generation</button>
    <button class="toolbar-button" id="lsystem-download" type="button">copy svg</button>
  </Fragment>

  <form id="lsystem-form" class="lsystem-rules-form">
    <label class="control-label lsystem-rules-label">
      rules, one per line
      <textarea id="lsystem-rules" rows="2">F=F+F--F+F</textarea>
    </label>
  </form>

  <div id="lsystem-readout" aria-live="polite">
    <span class="lsystem-help">F/G/A/B draw · f moves · +/- turns · [ ] branches</span>
  </div>

  <div class="canvas-stage" id="lsystem-stage">
    <svg id="lsystem-plot" role="img" aria-label="L-system turtle drawing"></svg>
  </div>

  <div id="lsystem-summary" class="lsystem-summary" aria-live="polite"></div>
</CanvasLayout>

<style>
  #lsystem-axiom { width: 4rem; }
  #lsystem-iterations, #lsystem-angle { width: 4rem; }

  .lsystem-rules-form {
    padding: .55rem var(--space);
    border-bottom: 1px solid var(--line);
  }

  .lsystem-rules-label {
    align-items: start;
    width: 100%;
  }

  #lsystem-rules {
    flex: 1;
    min-height: 2.4rem;
    resize: vertical;
    line-height: 1.45;
    padding: .35rem .45rem;
  }

  #lsystem-readout {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: .35rem var(--space);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: .78rem;
  }

  .lsystem-help { margin-left: auto; }

  .lsystem-summary {
    padding: .55rem var(--space);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .lsystem-summary :global(p) { margin: 0 0 .35rem; }
  .lsystem-summary :global(p:last-child) { margin-bottom: 0; }

  .canvas-stage {
    background-image:
      linear-gradient(color-mix(in srgb, var(--line) 60%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--line) 60%, transparent) 1px, transparent 1px);
    background-size: 1.5rem 1.5rem;
  }

  #lsystem-plot {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity .2s ease;
  }
</style>

<style is:global>
  .lsystem-path { fill: none; stroke: var(--fg); stroke-linecap: round; stroke-linejoin: round; }
  .lsystem-frame { fill: none; stroke: var(--line); }
  .lsystem-label { fill: var(--muted); font-family: ui-monospace, monospace; }
  #lsystem-plot.is-error { opacity: .32; }
  .lsystem-error { color: var(--fg); }
</style>

<script>
  import '../scripts/lsystem.ts';
</script>
