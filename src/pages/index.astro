---
import PageLayout from '../layouts/PageLayout.astro';
import { experiments } from '../data/experiments';
---

<PageLayout name="incomplete.fun" description="Small mathematical experiments, intentionally incomplete.">
  <section class="home-intro">
    <p class="eyebrow">small experiments</p>
    <h1>mathematical toys, kept intentionally incomplete.</h1>
    <p>A quiet collection of visual calculators and playgrounds. Pick a thread and pull.</p>
  </section>

  <nav class="experiment-list" aria-label="Experiments">
    {experiments.map((experiment) => (
      <a class="experiment-link" href={experiment.href}>
        <strong>{experiment.title}</strong>
        <small>{experiment.summary}</small>
      </a>
    ))}
  </nav>
</PageLayout>
