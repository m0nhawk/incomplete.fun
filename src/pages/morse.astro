---
import CanvasLayout from '../layouts/CanvasLayout.astro';
---

<CanvasLayout name="Morse landscape explorer" appId="morse-app" description="Contour editable height fields, mark critical points, and follow gradient-flow traces toward peaks, pits, and saddles.">
  <Fragment slot="toolbar">
    <label class="control-label">
      function
      <select id="morse-function">
        <option value="peaks">peaks</option>
        <option value="monkey">monkey saddle</option>
        <option value="ripples">ripples</option>
        <option value="basins">basins</option>
      </select>
    </label>
    <label class="control-label">contours <input id="morse-contours" type="number" min="5" max="28" value="16" /></label>
    <label class="control-label">flow lines <input id="morse-flows" type="number" min="0" max="60" value="28" /></label>
    <label class="control-label morse-check"><input id="morse-critical" type="checkbox" checked /> critical points</label>
  </Fragment>

  <div id="morse-readout" aria-live="polite">
    <span id="morse-summary"></span>
  </div>

  <div class="canvas-stage" id="morse-stage">
    <svg id="morse-plot" role="img" aria-label="Morse landscape contour plot"></svg>
  </div>
</CanvasLayout>

<script>
  import '../scripts/morse.ts';
</script>
