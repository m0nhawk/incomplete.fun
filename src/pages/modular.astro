---
import CanvasLayout from '../layouts/CanvasLayout.astro';
---

<CanvasLayout name="modular multiplication circles" appId="modular-app" description="Place residues around a circle and draw the multiplication map x → ax mod n.">
  <Fragment slot="toolbar">
    <label class="control-label">
      modulus n
      <input id="modular-n" type="number" min="2" max="120" value="48" />
    </label>
    <label class="control-label">
      multiplier a
      <input id="modular-a" type="number" min="0" max="240" value="2" />
    </label>
    <label class="control-label">
      chord curve
      <input id="modular-curve" type="range" min="0" max="100" value="54" />
    </label>
    <label class="control-label modular-check">
      <input id="modular-labels" type="checkbox" checked />
      labels
    </label>
    <button class="toolbar-button" id="modular-random" type="button">random unit</button>
  </Fragment>

  <div id="modular-readout" aria-live="polite">
    <span id="modular-summary"></span>
  </div>

  <div class="canvas-stage" id="modular-stage">
    <svg id="modular-plot" role="img" aria-label="Modular multiplication circle"></svg>
  </div>

  <section class="tool-card modular-orbits-card">
    <h2>orbits</h2>
    <div id="modular-orbits" class="modular-orbits" aria-live="polite"></div>
  </section>
</CanvasLayout>

<style>
  #modular-n, #modular-a { width: 5rem; }
  #modular-curve { width: 8rem; }
  .modular-check { cursor: pointer; }

  #modular-readout {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: .35rem var(--space);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: .78rem;
  }

  #modular-plot {
    display: block;
    width: 100%;
    height: 100%;
  }

  .modular-orbits-card {
    margin: 1rem var(--space);
  }

  .modular-orbits {
    display: grid;
    gap: .35rem;
    font-variant-numeric: tabular-nums;
    overflow-x: auto;
  }
</style>

<style is:global>
  .modular-axis { stroke: var(--line); }
  .modular-chord { fill: none; stroke: var(--fg); }
  .modular-node { fill: var(--bg); stroke: var(--fg); }
  .modular-node.is-fixed { fill: var(--fg); }
  .modular-label { fill: var(--muted); font: 11px ui-monospace, monospace; }
  .modular-orbit-row { border-top: 1px solid var(--line); padding-top: .35rem; white-space: nowrap; }
  .modular-orbit-row strong { color: var(--fg); }
</style>

<script>
  import '../scripts/modular.ts';
</script>
